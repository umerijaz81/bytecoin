  let count15: u8 = count14 + approvals.a15;
  assert(count15 >= threshold);
  let custody_state: field = poseidon_hash(policy, action);
  assert(prior_state == custody_state);
  assert(next_state != zero);
  assert(next_state != prior_state);
  return true;
