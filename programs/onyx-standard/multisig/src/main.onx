    assert(commitments.c08 != commitments.c10);
    assert(commitments.c09 != commitments.c10);
  }
  if participant_count > 11 {
    assert(commitments.c00 != commitments.c11);
    assert(commitments.c01 != commitments.c11);
    assert(commitments.c02 != commitments.c11);
    assert(commitments.c03 != commitments.c11);
    assert(commitments.c04 != commitments.c11);
