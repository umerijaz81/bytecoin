  }
  if participant_count > 12 {
    assert(commitments.c00 != commitments.c12);
    assert(commitments.c01 != commitments.c12);
    assert(commitments.c02 != commitments.c12);
    assert(commitments.c03 != commitments.c12);
    assert(commitments.c04 != commitments.c12);
