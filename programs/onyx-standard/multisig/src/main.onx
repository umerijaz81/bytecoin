  assert(policy == policy15);
  let count01: u8 = approvals.a00 + approvals.a01;
  let count02: u8 = count01 + approvals.a02;
  let count03: u8 = count02 + approvals.a03;
  let count04: u8 = count03 + approvals.a04;
  let count05: u8 = count04 + approvals.a05;
  let count06: u8 = count05 + approvals.a06;
