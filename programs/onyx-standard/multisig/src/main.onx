export fn authorize(public network: field, public anchor: field, public valid_from: u64, public expiry: u64, public fee: u64, public call_index: u8, public program_low: field, public program_high: field, public function_id: u32, public spends_low: field, public spends_high: field, public outputs_low: field, public outputs_high: field, public calls_low: field, public calls_high: field, public has_state: bool, public prior_low: field, public prior_high: field, public next_low: field, public next_high: field, public application_low: field, public application_high: field, public kind: u8, public policy: field, public action_low: field, public action_high: field, public threshold: u8, public participant_count: u8, public prior_state: field, public next_state: field, private commitments: Commitments, private approvals: Approvals, private secrets: Secrets) -> bool {
  let zero: field = network - network;
  let action: field = poseidon_hash(action_low, action_high);
  assert(kind == 3);
  assert(has_state);
  assert(fee == 0);
  assert(participant_count > 0);
  assert(participant_count <= 16);
  assert(threshold > 0);
  assert(threshold <= participant_count);
  if participant_count <= 0 { assert(commitments.c00 == zero); assert(approvals.a00 == 0); assert(secrets.s00 == zero); } else { assert(approvals.a00 <= 1); if approvals.a00 == 1 { let approval0: field = poseidon_hash(secrets.s00, action); assert(approval0 == commitments.c00); } else { assert(secrets.s00 == zero); } }
  if participant_count <= 1 { assert(commitments.c01 == zero); assert(approvals.a01 == 0); assert(secrets.s01 == zero); } else { assert(approvals.a01 <= 1); if approvals.a01 == 1 { let approval1: field = poseidon_hash(secrets.s01, action); assert(approval1 == commitments.c01); } else { assert(secrets.s01 == zero); } }
  if participant_count <= 2 { assert(commitments.c02 == zero); assert(approvals.a02 == 0); assert(secrets.s02 == zero); } else { assert(approvals.a02 <= 1); if approvals.a02 == 1 { let approval2: field = poseidon_hash(secrets.s02, action); assert(approval2 == commitments.c02); } else { assert(secrets.s02 == zero); } }
  if participant_count <= 3 { assert(commitments.c03 == zero); assert(approvals.a03 == 0); assert(secrets.s03 == zero); } else { assert(approvals.a03 <= 1); if approvals.a03 == 1 { let approval3: field = poseidon_hash(secrets.s03, action); assert(approval3 == commitments.c03); } else { assert(secrets.s03 == zero); } }
  if participant_count <= 4 { assert(commitments.c04 == zero); assert(approvals.a04 == 0); assert(secrets.s04 == zero); } else { assert(approvals.a04 <= 1); if approvals.a04 == 1 { let approval4: field = poseidon_hash(secrets.s04, action); assert(approval4 == commitments.c04); } else { assert(secrets.s04 == zero); } }
  if participant_count <= 5 { assert(commitments.c05 == zero); assert(approvals.a05 == 0); assert(secrets.s05 == zero); } else { assert(approvals.a05 <= 1); if approvals.a05 == 1 { let approval5: field = poseidon_hash(secrets.s05, action); assert(approval5 == commitments.c05); } else { assert(secrets.s05 == zero); } }
  if participant_count <= 6 { assert(commitments.c06 == zero); assert(approvals.a06 == 0); assert(secrets.s06 == zero); } else { assert(approvals.a06 <= 1); if approvals.a06 == 1 { let approval6: field = poseidon_hash(secrets.s06, action); assert(approval6 == commitments.c06); } else { assert(secrets.s06 == zero); } }
  if participant_count <= 7 { assert(commitments.c07 == zero); assert(approvals.a07 == 0); assert(secrets.s07 == zero); } else { assert(approvals.a07 <= 1); if approvals.a07 == 1 { let approval7: field = poseidon_hash(secrets.s07, action); assert(approval7 == commitments.c07); } else { assert(secrets.s07 == zero); } }
  if participant_count <= 8 { assert(commitments.c08 == zero); assert(approvals.a08 == 0); assert(secrets.s08 == zero); } else { assert(approvals.a08 <= 1); if approvals.a08 == 1 { let approval8: field = poseidon_hash(secrets.s08, action); assert(approval8 == commitments.c08); } else { assert(secrets.s08 == zero); } }
  if participant_count <= 9 { assert(commitments.c09 == zero); assert(approvals.a09 == 0); assert(secrets.s09 == zero); } else { assert(approvals.a09 <= 1); if approvals.a09 == 1 { let approval9: field = poseidon_hash(secrets.s09, action); assert(approval9 == commitments.c09); } else { assert(secrets.s09 == zero); } }
  if participant_count <= 10 { assert(commitments.c10 == zero); assert(approvals.a10 == 0); assert(secrets.s10 == zero); } else { assert(approvals.a10 <= 1); if approvals.a10 == 1 { let approval10: field = poseidon_hash(secrets.s10, action); assert(approval10 == commitments.c10); } else { assert(secrets.s10 == zero); } }
  if participant_count <= 11 { assert(commitments.c11 == zero); assert(approvals.a11 == 0); assert(secrets.s11 == zero); } else { assert(approvals.a11 <= 1); if approvals.a11 == 1 { let approval11: field = poseidon_hash(secrets.s11, action); assert(approval11 == commitments.c11); } else { assert(secrets.s11 == zero); } }
  if participant_count <= 12 { assert(commitments.c12 == zero); assert(approvals.a12 == 0); assert(secrets.s12 == zero); } else { assert(approvals.a12 <= 1); if approvals.a12 == 1 { let approval12: field = poseidon_hash(secrets.s12, action); assert(approval12 == commitments.c12); } else { assert(secrets.s12 == zero); } }
  if participant_count <= 13 { assert(commitments.c13 == zero); assert(approvals.a13 == 0); assert(secrets.s13 == zero); } else { assert(approvals.a13 <= 1); if approvals.a13 == 1 { let approval13: field = poseidon_hash(secrets.s13, action); assert(approval13 == commitments.c13); } else { assert(secrets.s13 == zero); } }
  if participant_count <= 14 { assert(commitments.c14 == zero); assert(approvals.a14 == 0); assert(secrets.s14 == zero); } else { assert(approvals.a14 <= 1); if approvals.a14 == 1 { let approval14: field = poseidon_hash(secrets.s14, action); assert(approval14 == commitments.c14); } else { assert(secrets.s14 == zero); } }
  if participant_count <= 15 { assert(commitments.c15 == zero); assert(approvals.a15 == 0); assert(secrets.s15 == zero); } else { assert(approvals.a15 <= 1); if approvals.a15 == 1 { let approval15: field = poseidon_hash(secrets.s15, action); assert(approval15 == commitments.c15); } else { assert(secrets.s15 == zero); } }
  if participant_count > 1 {
    assert(commitments.c00 != commitments.c01);
  }
  if participant_count > 2 {
    assert(commitments.c00 != commitments.c02);
    assert(commitments.c01 != commitments.c02);
  }
  if participant_count > 3 {
    assert(commitments.c00 != commitments.c03);
    assert(commitments.c01 != commitments.c03);
    assert(commitments.c02 != commitments.c03);
